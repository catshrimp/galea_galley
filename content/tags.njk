---js
const eleventyNavigation = {
	key: "Теги",
	order: 3
};
---
<h1>Теги</h1>

<ul>
{% for tag in collections | getKeys | filterTagList | sortByPopularity(collections) %}
	{% set tagUrl %}/tags/{{ tag }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a> ({{ collections[tag].length }})</li>
{% endfor %}
</ul>
